<?xml version="1.0" encoding="UTF-8"?>
<!-- Enregistre le vérificateur grammatical pour les variantes du français. -->
<oor:component-data oor:name="Linguistic" oor:package="org.openoffice.Office"
                    xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <node oor:name="ServiceManager">
    <node oor:name="GrammarCheckers">
      <node oor:name="org.correcteur.Correcteur" oor:op="fuse">
        <prop oor:name="Locales" oor:type="oor:string-list">
          <value>fr-FR fr-BE fr-CA fr-CH fr-LU fr-MC</value>
        </prop>
      </node>
    </node>
  </node>
</oor:component-data>
